# Local single-process application. Keep the SQLite database on a local disk.
DATABASE_PATH=data/pplinks.sqlite3
PORT=5000
REQUEST_TIMEOUT=20
REQUEST_INTERVAL=3
REQUEST_RETRIES=2
# Selenium renders permitted pages with standard Chrome; http uses HTML only.
SCRAPER_BACKEND=selenium
# Advisory robots.txt policy. HTTP denials, login and CAPTCHA checks stay active.
RESPECT_ROBOTS=true
SELENIUM_HEADLESS=true
SELENIUM_RENDER_WAIT=3
# Optional installed Chrome / ChromeDriver paths. Leave blank for Selenium Manager.
CHROME_BINARY=
CHROMEDRIVER_PATH=
MAX_UPLOAD_MB=10
CATEGORIES_PATH=config/categories.json
# Set a long random value when keeping browser sessions across restarts.
SECRET_KEY=

# One continually updated purchase-team workbook.
PURCHASE_MASTER_PATH=outputs/Purchase-Team-Master.xlsx

# Bind address and allowed request hostnames for hosting.
HOST=127.0.0.1
TRUSTED_HOSTS=localhost,127.0.0.1,[::1]

# Maximum rendered Chrome page size, 1-64 MB. HTTP response cap is separate.
SELENIUM_MAX_PAGE_MB=32

# Document library (stored beside the SQLite database by default)
DOCUMENT_MAX_FILE_MB=20
DOCUMENT_MAX_BATCH_MB=50
# DOCUMENTS_DIR=C:/path/to/persistent/documents
